From c849c91480e063e5d31524bc8a367fea2bc125b8 Mon Sep 17 00:00:00 2001
From: Francesco Cervigni <francesco.cervigni@ext-energy-pool.eu>
Date: Thu, 7 May 2026 17:51:41 +0200
Subject: [PATCH 1/1] mender boot

---
 boot-scr.its                 | 36 +++++++++++++++++++++++++++++++++
 boot-scr.txt                 | 29 +++++++++++++++++++++++++++
 include/configs/evb_rk3568.h | 39 +++++++++++++++++++++++++++++++++++-
 3 files changed, 103 insertions(+), 1 deletion(-)
 create mode 100644 boot-scr.its
 create mode 100644 boot-scr.txt

diff --git a/boot-scr.its b/boot-scr.its
new file mode 100644
index 0000000..17a856a
--- /dev/null
+++ b/boot-scr.its
@@ -0,0 +1,36 @@
+/dts-v1/;
+
+/ {
+    description = "EC942 signed boot.scr (Mender / distro_bootcmd compatible)";
+    #address-cells = <1>;
+
+    images {
+        bootscr {
+            description = "U-Boot boot script";
+            data = /incbin/("@BOOTSCR_TXT@");
+            type = "script";
+            arch = "arm64";
+            compression = "none";
+            hash {
+                algo = "sha256";
+            };
+        };
+    };
+
+    configurations {
+        default = "conf";
+
+        conf {
+            description = "Default boot script configuration";
+            script = "bootscr";
+
+            signature {
+                algo = "sha256,rsa2048";
+                padding = "pss";
+                key-name-hint = "dev";
+                required = "conf";
+                sign-images = "script";
+            };
+        };
+    };
+};
diff --git a/boot-scr.txt b/boot-scr.txt
new file mode 100644
index 0000000..99b0b9d
--- /dev/null
+++ b/boot-scr.txt
@@ -0,0 +1,29 @@
+# EC942 boot.scr — Mender-compatible reference script (signed FIT payload)
+#
+# When CONFIG_FIT_SIGNATURE=y, U-Boot's `source` command forces signature
+# verification, so this body is only executed if the wrapping FIT image
+# is signed by the same dev.key embedded in u-boot.dtb.
+#
+# Real Mender deployments will replace this body with the script that
+# Mender's u-boot integration emits (it sets `mender_boot_part`,
+# `mender_boot_part_hex`, etc., reads them on boot, and bootms accordingly).
+# This reference body proves the chain end-to-end:
+#   1. distro_bootcmd scanned the rootfs partition
+#   2. /boot/boot.scr was found
+#   3. signature was verified by `source`
+#   4. the script body actually ran on the U-Boot console
+# It then delegates to boot_fit so the device still completes boot.
+
+echo "===================================================="
+echo "  EC942 boot.scr verified and executing"
+echo "===================================================="
+echo "  devtype          = ${devtype}"
+echo "  devnum           = ${devnum}"
+echo "  distro_bootpart  = ${distro_bootpart}"
+echo "  android_slot_suffix = ${android_slot_suffix}"
+echo "  scriptaddr       = ${scriptaddr}"
+echo "----------------------------------------------------"
+echo "  Delegating to boot_fit (FIT-signed kernel chain)"
+echo "===================================================="
+
+boot_fit
diff --git a/include/configs/evb_rk3568.h b/include/configs/evb_rk3568.h
index f7318c3..7cbdd51 100644
--- a/include/configs/evb_rk3568.h
+++ b/include/configs/evb_rk3568.h
@@ -20,7 +20,44 @@
 #define CONFIG_SYS_MMC_ENV_DEV		0
 
 #undef CONFIG_BOOTCOMMAND
-#define CONFIG_BOOTCOMMAND RKIMG_BOOTCOMMAND
+/*
+ * Mender / boot.scr support — single shared boot.scr in oem partition.
+ *
+ * Architectural rationale:
+ *   boot.scr is the *slot dispatcher* (it decides which kernel/rootfs
+ *   slot to boot).  It must not live inside the rootfs that it selects,
+ *   because:
+ *     - On OTA the new rootfs replaces boot.scr too, so a faulty
+ *       newly-pushed boot.scr could brick the slot decision logic.
+ *     - Rollback semantics break: the rolled-back rootfs's boot.scr
+ *       might disagree with what the system needs to do.
+ *   Mender (and the standard Yocto secure-OTA pattern) therefore keeps
+ *   boot.scr in a SHARED, A/B-independent partition.
+ *
+ * On this device we use the existing 128 MB `oem` partition
+ * (mmcblk0p8) — it is ext4-formatted, A/B-independent, and large
+ * enough for boot.scr plus future shared boot artefacts.  oem.img is
+ * generated by ec900-image:do_updateimg with /boot.scr at its root.
+ *
+ * scan_dev_for_scripts uses boot_a_script -> source ${scriptaddr},
+ * which under CONFIG_FIT_SIGNATURE=y forces signature verification.
+ * If oem has no boot.scr or its signature fails, we fall through to
+ * RKIMG_BOOTCOMMAND (boot_fit) — the existing FIT-secure-boot path
+ * remains the safety net.
+ *
+ * distro_bootcmd is intentionally bypassed: Rockchip's afptool /
+ * parameter.txt format does not propagate the GPT
+ * legacy_bios_bootable flag, and distro's BOOT_TARGET_DEVICES would
+ * otherwise probe mtd/usb/dhcp/pxe and waste ~30 s per network target
+ * on PHY-autoneg timeout.
+ */
+#define CONFIG_BOOTCOMMAND						\
+		"if load mmc 0:8 ${scriptaddr} /boot.scr; then "	\
+			"echo Found /boot.scr on oem partition; "	\
+			"source ${scriptaddr}:bootscr; "		\
+			"echo SCRIPT EXIT or FAILED, falling back; "	\
+		"fi; "							\
+		RKIMG_BOOTCOMMAND
 
 #ifdef CONFIG_USB_FUNCTION_DFU
 #define CONFIG_SET_DFU_ALT_INFO
-- 
