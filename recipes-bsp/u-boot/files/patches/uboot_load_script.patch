diff --git a/include/configs/evb_rk3568.h b/include/configs/evb_rk3568.h
--- a/include/configs/evb_rk3568.h	(revision 02df6b91110931b588f3585282fad97d9495bc48)
+++ b/include/configs/evb_rk3568.h	(date 1778488110208)
@@ -20,7 +20,20 @@
 #define CONFIG_SYS_MMC_ENV_DEV		0
 
 #undef CONFIG_BOOTCOMMAND
-#define CONFIG_BOOTCOMMAND RKIMG_BOOTCOMMAND
+/*
+ * Mender / boot.scr support: try distro_bootcmd first so a signed
+ * boot.scr (placed at /boot/boot.scr in the active rootfs slot) is
+ * scanned, signature-verified by `source` (forced because
+ * CONFIG_FIT_SIGNATURE=y), and executed.  Fall back to RKIMG_BOOTCOMMAND
+ * (boot_fit) if no boot.scr is found or its verification fails.
+ */
+#define CONFIG_BOOTCOMMAND						\
+	"setenv devtype mmc; setenv devnum 0; "			\
+	"setenv prefix /boot/; "				\
+	"for distro_bootpart in 6 7; do "			\
+	"run scan_dev_for_scripts; "			\
+	"done; "						\
+	RKIMG_BOOTCOMMAND
 
 #ifdef CONFIG_USB_FUNCTION_DFU
 #define CONFIG_SET_DFU_ALT_INFO
